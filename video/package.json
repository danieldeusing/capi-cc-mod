{
  "name": "capi-video",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Capi out/capi.mp4 && remotion render src/index.ts CapiWide out/capi-16x9.mp4",
    "gif": "remotion ffmpeg -y -i out/capi-16x9.mp4 -r 10 -vf \"scale=960:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=256:stats_mode=diff[p];[b][p]paletteuse=dither=none:diff_mode=rectangle\" capi.gif"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.529"
  }
}
