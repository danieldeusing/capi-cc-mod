# Copy to .env (git ignores it) and change what you like. A missing key keeps
# its default; the defaults are the values below. Capi reads this file when a
# session starts, so open a new session (or /reload-plugins) after a change.

# The language Capi teaches, and the learner's own language: explanations,
# translations and grammar notes are in CAPI_NATIVE_LANGUAGE.
CAPI_LEARN_LANGUAGE=Brazilian Portuguese
CAPI_NATIVE_LANGUAGE=German
# The icon on the translation button.
CAPI_NATIVE_FLAG=🇩🇪

# Who is learning, finishing the sentence "native German speaker who …".
CAPI_LEARNER=has lived in Brazil for four years and gets by in everyday Portuguese (about A2/B1), with real gaps, above all in grammar

# What the facts on the cards are about.
CAPI_TOPICS=Brazil, science and nature, technology, history (Brazil and the world), everyday life, food, health and fitness

# The conjugation table: rows are persons, columns are tenses, separated by |.
CAPI_PERSONS=eu|você|ele/ela|nós|vocês
CAPI_TENSES=presente|pretérito perfeito|pretérito imperfeito|futuro|subjuntivo presente

# When the band is there: always, or working (only while Claude works).
CAPI_SHOW=always
